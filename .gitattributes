# Normalize line endings in the repo; check out with the platform's native endings...
* text=auto

# ...except scripts that must keep a specific ending on every OS.
*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.ico  binary
*.woff2 binary
*.db   binary

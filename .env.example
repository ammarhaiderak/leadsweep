# LeadSweep configuration.
# Copy to `.env` and fill in what you need:  cp .env.example .env
# `.env` is gitignored - never commit it. Blank values fall back to the built-in defaults.

# =============================================================================
# 1. Owner login (required to use the web UI)
# =============================================================================
# The owner account is created on first sign-in with exactly these credentials.
# Nothing is pre-seeded; there is no default password.
LEADSWEEP_ADMIN_EMAIL=
LEADSWEEP_ADMIN_PASSWORD=
LEADSWEEP_ADMIN_NAME=Owner

# =============================================================================
# 2. API key (required for the /api/* routes, scripts and integrations)
# =============================================================================
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, protected /api/* routes return 503 (fails closed).
LEADSWEEP_API_KEY=

# Browser origins allowed to call the API (comma-separated, no wildcards).
# LEADSWEEP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# 3. LLM qualification - auto | groq | ollama | heuristic
# =============================================================================
# Leave the Groq key blank to run fully locally on rules + Ollama.
LEADSWEEP_LLM_PROVIDER=auto
LEADSWEEP_GROQ_API_KEY=
# LEADSWEEP_GROQ_MODEL=openai/gpt-oss-120b
# LEADSWEEP_GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# LEADSWEEP_OLLAMA_URL=http://localhost:11434
# LEADSWEEP_LLM_MODEL=qwen2.5:3b
# Max candidates per job sent to the LLM (lower this on free-tier keys).
# LEADSWEEP_LLM_TOP_N=150
# LEADSWEEP_LLM_TIMEOUT_S=120

# =============================================================================
# 4. X / Twitter (needs your own logged-in session cookies)
# =============================================================================
# Create sessions.json with:  python -m scripts.capture_session --id acct-1
# or copy sessions.example.json and paste your auth_token / ct0 cookies.
LEADSWEEP_SESSIONS_FILE=sessions.json
# LEADSWEEP_STATE_FILE=data/session_state.json
# LEADSWEEP_HEADLESS=true
# Skip images/video/fonts while scraping (saves bandwidth + RAM). Set false to load them.
# LEADSWEEP_BLOCK_MEDIA=true
# LEADSWEEP_BROWSER_CHANNEL=chrome
# Match these to your machine's real locale/timezone.
# LEADSWEEP_LOCALE=en-US
# LEADSWEEP_TIMEZONE_ID=UTC
# LEADSWEEP_MIN_DELAY=1.5
# LEADSWEEP_MAX_DELAY=4.5
# LEADSWEEP_MAX_SCROLLS=12
# LEADSWEEP_SESSION_COOLDOWN_S=900

# =============================================================================
# 5. Reddit (no credentials needed)
# =============================================================================
# public_unauthenticated | offline_fixtures | disabled
# LEADSWEEP_REDDIT_ACCESS_MODE=public_unauthenticated
# arctic_shift (public archive, works without OAuth) | reddit_json (usually 403 without OAuth)
# LEADSWEEP_REDDIT_SOURCE_PROVIDER=arctic_shift
# LEADSWEEP_REDDIT_USER_AGENT=python:leadsweep:1.0 (self-hosted public-content-reader)
# LEADSWEEP_REDDIT_MAX_REQUESTS_PER_MINUTE=30

# =============================================================================
# 6. Telegram (public channels work without an account)
# =============================================================================
# auto | direct | relay
# LEADSWEEP_TELEGRAM_TRANSPORT=auto
# LEADSWEEP_TELEGRAM_GLOBAL_TOPICS=hiring, remote developer, looking for agency
# LEADSWEEP_TELEGRAM_CHANNEL_REGISTRY=
# Optional MTProto (Telethon) access - from https://my.telegram.org
# LEADSWEEP_TELEGRAM_API_ID=
# LEADSWEEP_TELEGRAM_API_HASH=

# =============================================================================
# 7. Optional email notifications (SMTP)
# =============================================================================
# Without SMTP, outgoing emails are only written to the logs.
# LEADSWEEP_OWNER_EMAIL=
# LEADSWEEP_FROM_EMAIL=
# LEADSWEEP_FROM_NAME=LeadSweep
# LEADSWEEP_SMTP_HOST=
# LEADSWEEP_SMTP_PORT=587
# LEADSWEEP_SMTP_USERNAME=
# LEADSWEEP_SMTP_PASSWORD=
# LEADSWEEP_SMTP_USE_TLS=true

# =============================================================================
# 8. Paths & misc
# =============================================================================
# LEADSWEEP_DB_PATH=data/leadsweep.db
# LEADSWEEP_OUT_DIR=data/out
# LEADSWEEP_QUERIES_FILE=config/queries.toml
# Serve the built frontend from the API (set automatically in Docker).
# LEADSWEEP_WEB_DIST=project/dist
# LEADSWEEP_WEBHOOK_URL=
# LEADSWEEP_LOG_LEVEL=INFO
